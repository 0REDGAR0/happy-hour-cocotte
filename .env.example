APP_PORT=3000
HAPPY_HOUR_DURATION_SECONDS=600
FOOTBALL_PROVIDER=manual

# URL stable affichee dans /admin et /api/server-info si vous avez reserve une IP.
# Exemple : PUBLIC_BASE_URL=http://192.168.1.50:3000
PUBLIC_BASE_URL=

# API-Football / API-Sports v3. Laisser vide pour garder uniquement le mode simulation.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Spotify. Laisser vide pour garder spotify.status="not_configured" dans /api/state.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
SPOTIFY_REFRESH_TOKEN=
